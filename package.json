{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "cd packages/admin-panel && npm run dev",
    "dev:kiosk": "cd packages/kiosk-app && npm run dev",
    "dev:mobile": "cd packages/mobile-app && npm run dev",
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:backend-laravel": "cd packages/backend-laravel && npm run dev",
    "build:admin": "cd packages/admin-panel && npm run build",
    "build:kiosk": "cd packages/kiosk-app && npm run build",
    "build:mobile": "cd packages/mobile-app && npm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
