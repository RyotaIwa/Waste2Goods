PORT=3001

# ================================
# Core
# ================================
# Required in production (auth-jwt.js refuses to start without it).
# Generate: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=waste2goods
JWT_AUDIENCE=waste2goods-app

# Reverse-proxy hop count behind your edge (Caddy/Nginx/DO App Platform = 1).
# Drives req.ip, which the rate limiters and cache keys depend on.
# Cloudflare (orange cloud) in front of Caddy = 2 (CF + Caddy).
TRUST_PROXY=1

# Extra browser origins allowed to call the API (comma-separated).
# Only needed if the frontends are on a DIFFERENT domain than the API.
CORS_ORIGINS=

# Same list, for the CSRF Origin guard (csrfOriginGuard in csrf.js).
# Required whenever the SPA origin differs from the API host, otherwise every
# POST/PUT/DELETE gets 403. Same-origin deployments can leave this empty.
CSRF_ORIGINS=

# Max JSON/urlencoded body size. Image uploads use a separate route-level limit.
BODY_LIMIT=100kb

# ================================
# MySQL
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=waste2goods
DB_CONN_LIMIT=10

# DigitalOcean Managed MySQL etc. Requires TLS.
#   DB_SSL=1 + DB_SSL_CA=/path/to/ca-certificate.crt   → verified (preferred)
#   DB_SSL=1 + DB_SSL_REJECT_UNAUTHORIZED=0            → private VPC only
DB_SSL=0
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=1

# Apply column migrations + reference seeds (roles, materials, tasks, rewards) on boot.
# Set to false once the schema is frozen to run the app without DDL privileges.
DB_RUN_MIGRATIONS=true

# ================================
# Demo accounts — keep FALSE on any public deployment
# ================================
# When true, the server recreates the A-001 admin and the Maria Santos resident
# on every boot AND resets their password hashes to the values below.
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@waste2goods.ph
ADMIN_PASSWORD=
RESIDENT_EMAIL=resident@cabantian.ph
RESIDENT_PASSWORD=
# Kiosk terminal PIN. Leave EMPTY to disable /api/auth/kiosk-login entirely.
KIOSK_PIN=

# ================================
# Redis (sessions, refresh tokens, rate limits, cache)
# Optional — falls back to in-memory, but then sessions die on every restart
# and rate-limit counters reset. Set REDIS_ENABLED=true in production.
# ================================
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Managed Redis with TLS: REDIS_URL=rediss://default:password@host:port
REDIS_URL=

# ================================
# OAuth 2.0 External IdPs (live)
# Leave empty to use the local demo IdP (built into the app).
# ================================

# Google Cloud OAuth 2.0 — Create at https://console.cloud.google.com/ → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback  (EXACTLY — no trailing slash)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# GitHub OAuth App — Create at https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:3001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ================================
# Appwrite Cloud OAuth Proxy (Preferred — works on LAN IPs too!)
#   1. Create project at https://cloud.appwrite.io/ → get Project ID + API Key
#   2. Project → Auth → OAuth → Enable Google → use Appwrite's callback URL in Google Console:
#      https://fra.cloud.appwrite.io/v1/account/sessions/oauth2/callback/google/<YOUR_PROJECT_ID>
#      (region matches APPWRITE_REGION below, e.g. fra, sgp, nyc, lon, sfo, tok, syd, etc.)
#   3. In Google Console, ADD that Appwrite callback as Authorized redirect URI, NOT the localhost one!
# ================================
# Your Appwrite project ID (from Console → Settings). Example: 6aac05cf002c49954059
APPWRITE_PROJECT_ID=
# Project → API Keys → + Add API Key → scopes: "users.read", "auth.read", "auth.write"
APPWRITE_API_KEY=
# Use https://cloud.appwrite.io/v1 unless you self-host Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Region code for OAuth callback (appears in your Appwrite URL): fra | sgp | nyc | lon | sfo | tok | syd | ...
APPWRITE_REGION=fra
# Optional — override platform OAuth redirect if custom domain
APPWRITE_CALLBACK_URL=
