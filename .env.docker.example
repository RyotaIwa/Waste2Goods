# ════════════════════════════════════════════════════════════════════
# Waste2Goods — Docker Compose environment template
#
#   1. cp .env.docker.example .env      (on the server: .env, never committed)
#   2. Fill in every value marked  <REQUIRED>
#   3. docker compose up -d --build
#
# .env is gitignored. Never commit the real file.
# ════════════════════════════════════════════════════════════════════

# ── Public domain (drives Caddy's automatic HTTPS) ──────────────────
# Point an A record at your droplet's IP first, then set this.
# Leave as-is for local testing (Caddy issues a self-signed cert).
DOMAIN=localhost

# ── MySQL ───────────────────────────────────────────────────────────
DB_NAME=waste2goods
DB_USER=w2g
DB_PASSWORD=<REQUIRED - generate: openssl rand -base64 24>
MYSQL_ROOT_PASSWORD=<REQUIRED - generate: openssl rand -base64 24>

# DigitalOcean Managed MySQL passes TLS through compose (db-mysql.js reads
# these; see docker-compose.managed-db.yml). Leave OFF for the local `db`
# container (same Docker network — no TLS needed).
DB_SSL=0
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=1

# Apply column migrations + reference seeds on boot.
# After the first successful boot you may set this to false to freeze the schema.
DB_RUN_MIGRATIONS=true

# ── JWT signing secrets ─────────────────────────────────────────────
# <REQUIRED> and MUST differ from anything used in local development.
# Generate: openssl rand -hex 48
JWT_SECRET=<REQUIRED - generate: openssl rand -hex 48>
JWT_REFRESH_SECRET=<REQUIRED - generate: openssl rand -hex 48>
JWT_ISSUER=waste2goods
JWT_AUDIENCE=waste2goods-app

# ── Demo accounts ───────────────────────────────────────────────────
# Set to true ONLY for a private demo/staging box. This recreates the
# admin (A-001) and resident (Maria Santos) accounts on every boot and
# will reset their password hashes to the values below.
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@waste2goods.ph
ADMIN_PASSWORD=<set a strong password, or leave empty and create an admin manually>
RESIDENT_EMAIL=resident@cabantian.ph
RESIDENT_PASSWORD=<set a strong password, or leave empty>

# Kiosk terminal PIN. Leave EMPTY to disable kiosk-login entirely.
KIOSK_PIN=<set a non-trivial PIN>

# ── Reverse proxy / platform ────────────────────────────────────────
# Hop counts drive Express `trust proxy` → req.ip → rate limiters.
#   Caddy alone (default compose)            → TRUST_PROXY=1
#   Cloudflare (orange cloud) in front + Caddy → TRUST_PROXY=2
#   App Platform or another LB in front      → add +1
# Behind another proxy, also set Caddy to trust it (see DEPLOYMENT.md).
TRUST_PROXY=1

# Comma-separated browser origins allowed to call the API.
# Same-origin requests (Caddy serves SPA + API on one domain) need nothing here.
# Only set this if the frontends live on a DIFFERENT domain.
CORS_ORIGINS=

# Same list, for the CSRF Origin guard (csrfOriginGuard in csrf.js).
# Required whenever the SPA origin differs from the API host, e.g. Cloudflare
# Pages calling api.example.com, otherwise every POST/PUT/DELETE gets 403.
# Same-origin deployments can leave this empty.
CSRF_ORIGINS=

BODY_LIMIT=100kb

# ── OAuth 2.0 external identity providers (optional) ────────────────
# The local demo IdP works without these. To enable real Google/GitHub login,
# set the credentials AND register the callback URL as https://<DOMAIN>/api/...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# ── Appwrite Cloud OAuth (optional) ─────────────────────────────────
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_REGION=fra
APPWRITE_CALLBACK_URL=
